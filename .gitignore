# === OS ===
.DS_Store
Thumbs.db

# === IDE ===
.idea/
.vscode/
*.iml
*.iws
*.ipr

# === Env ===
.env
.env.*
!.env.example

# === Dart / Flutter ===
# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# pubspec.lock 은 추적한다(아래 무시 목록에서 뺐다). 배포되는 앱이라 어떤
# 버전으로 만들어졌는지가 남아야 한다. 기록이 없으면 빌드 서버가 매번 새로
# 버전을 고르고, 어제 되던 빌드가 오늘 깨져도 무엇이 바뀌었는지 되짚을 수 없다.

# Directory created by dartdoc
doc/api/

# Avoid committing generated Javascript files:
*.dart.js
*.info.json
*.js
*.js_
*.js.deps
*.js.map

# Code generation outputs
*.g.dart
*.freezed.dart

# Flutter plugins metadata
.flutter-plugins
.flutter-plugins-dependencies

# === Android ===
android/.gradle/
android/captures/
android/local.properties
android/key.properties
android/app/debug/
android/app/profile/
android/app/release/
*.jks
*.keystore

# === iOS ===
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/DartDefines.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Runner/GeneratedPluginRegistrant.*
*.mode1v3
*.mode2v3
*.perspectivev3
*.pbxuser
*.xccheckout
xcuserdata/
DerivedData/

# === macOS / Linux / Windows desktop ===
macos/Flutter/ephemeral/
linux/flutter/ephemeral/
windows/flutter/ephemeral/

# === Web ===

# === Coverage ===
coverage/

# === Misc ===
*.bak
*.tmp
*.log

# 호스팅 배포 도구가 남기는 업로드 캐시. 배포할 때마다 바뀌고 다른 사람
# 환경에서는 쓸모가 없다.
.firebase/

# 세션마다 달라지는 서버 주소. 게시 스크립트가 매번 새로 쓴다.
hosting/app_config.json
